{
  "name": "edu-grade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:production": "NODE_ENV=production next build",
    "build:vercel": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "build:analyze": "ANALYZE=true npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ujian": "vitest run tests/ujian",
    "test:ujian-load": "vitest run tests/ujian/ujian-load.test.ts --testTimeout=300000",
    "test:watch": "vitest --watch",
    "test:report": "vitest run --coverage && playwright show-report",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:ujian": "playwright test tests/e2e/ujian-complete-flow.spec.ts",
    "e2e:load": "playwright test tests/e2e/load-test-ujian.spec.ts",
    "setup-test-data": "ts-node tests/setup/setup-test-data.ts",
    "clean-test-data": "ts-node tests/setup/clean-test-data.ts",
    "execute-tests": "ts-node execute-tests.ts",
    "execute-tests:quick": "ts-node execute-tests.ts --quick",
    "db:seed": "psql -h localhost -U postgres -d edugrade_test -f tests/setup/seed-150-students.sql",
    "db:setup": "psql -h localhost -U postgres -d edugrade_test -f supabase/schema.sql"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@heroui/react": "^2.8.3",
    "@heroui/theme": "^2.4.21",
    "@hookform/resolvers": "^5.2.0",
    "@playwright/test": "^1.55.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.52.1",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vercel/analytics": "^1.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "faker": "^6.6.6",
    "framer-motion": "^12.23.12",
    "happy-dom": "^18.0.1",
    "jsdom": "^27.0.0",
    "lucide-react": "^0.540.0",
    "msw": "^2.11.3",
    "next": "15.4.4",
    "next-themes": "^0.4.6",
    "openai": "^5.23.0",
    "playwright": "^1.55.1",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.61.1",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.1.0",
    "sonner": "^2.0.6",
    "supabase": "^2.33.7",
    "tailwind-merge": "^3.3.1",
    "vitest": "^3.2.4",
    "zod": "^4.0.14",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "pg": "^8.16.3",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.9.2"
  }
